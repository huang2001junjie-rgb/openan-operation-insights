{
  "name": "@openan/api",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAN 运营洞察平台 · 后端服务（NestJS 10）",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "collect": "node dist/collector/main.js",
    "collect:dev": "ts-node -r tsconfig-paths/register src/collector/main.ts",
    "collect:full": "node dist/collector/main.js --mode=full",
    "collect:dev:full": "ts-node -r tsconfig-paths/register src/collector/main.ts --mode=full",
    "collect:check": "node scripts/collector-check.mjs",
    "collect:meetings": "ts-node -r tsconfig-paths/register scripts/import-meetings.ts",
    "identity:check": "node scripts/identity-check.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
