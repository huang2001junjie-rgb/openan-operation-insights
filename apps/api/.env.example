# ─── 运行环境 ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# JSON 数据目录（相对仓库根或绝对路径）
DATA_DIR=../../data

# ─── 跨域（开发期由 Vite 代理，通常无需配置）───────────────
CORS_ORIGINS=http://localhost:5173

# ─── 缓存与日志 ───────────────────────────────────────────
CACHE_TTL_SECONDS=300
LOG_LEVEL=log

# ─── GitHub 采集（阶段二 / 三）────────────────────────────
GITHUB_TOKEN=
GITHUB_ORGS=
GITHUB_REPOS=
# 兜底回溯窗口（天）：仅当本地游标缺失/损坏时生效；正常增量以 lastSyncAt 为准
GITHUB_LOOKBACK_DAYS=3650
# GraphQL 端点覆盖（GitHub Enterprise / 代理时填写；留空用 https://api.github.com/graphql）
GITHUB_API_ENDPOINT=
# 离线采集：指向固定记录 JSON 时跳过网络请求，用于无 token 验证「聚合→归属→落盘」全链路
GITHUB_FIXTURE=

# ─── Confluence 采集（见 05 文档第 3 章）───────────────────
# 站点根地址（不含 /wiki 后缀），如 https://example.atlassian.net
CONFLUENCE_BASE_URL=
# 个人访问令牌（Bearer 认证）；缺失时采集器直接失败，不会静默跳过
CONFLUENCE_TOKEN=
# 目标空间 key 白名单（逗号分隔），本项目 Confluence 采集的唯一单位
CONFLUENCE_SPACES=
# 兜底回溯窗口（天）：仅当本地游标缺失/损坏时生效
CONFLUENCE_LOOKBACK_DAYS=3650
# 离线采集：指向固定页面记录 JSON 时跳过网络请求，用于无 token 验证全链路
# （固定文件可含 bodies / users 字段，以覆盖正文口径解析与展示名查询）
CONFLUENCE_FIXTURE=

# ── 口径选择器（2026-09-28 对真实空间只读实测定稿，见 ADR-0009）──────
# 以下全部为「留空即用内置默认」，仅在真实空间改版（改名/改列/跨年）时就地校正，
# 改口径不必改代码；默认值集中在 src/collector/collector.constants.ts。
# 需求来源页标题（默认 Requirement Proposal）
CONFLUENCE_REQUIREMENT_PAGE_TITLE=
# 需求来源页必须位于该祖先标题之下（默认 Release Planning；用于排除 Releases 下的同名模板页）
CONFLUENCE_REQUIREMENT_ANCESTOR_TITLE=
# 需求表格里联系人列的列名（默认 Contacts；每个 @ 提及各算 1 条）
CONFLUENCE_REQUIREMENT_CONTACT_COLUMN=
# 需求表格里标题列的列名（默认 Requirement Title；仅用于快照与日志可读性）
CONFLUENCE_REQUIREMENT_TITLE_COLUMN=
# 会议纪要父页标题正则（默认 ^\d{4} - TSC Minutes$；用模式而非字面量以支持跨年）
CONFLUENCE_MINUTES_PARENT_PATTERN=
# 会议纪要页标题正则（默认 ^\d{4}-\d{2}-\d{2} TSC Minutes$）
CONFLUENCE_MINUTES_TITLE_PATTERN=
# 议题分享所取的标题段名（默认 Agenda；该段内的 @ 才计入，段落与表格行都算）
CONFLUENCE_MINUTES_AGENDA_HEADING=

# ─── 身份匹配控制台写接口鉴权 ─────────────────────────────
# 仅用于 /api/identity/* 的写方法（POST/PATCH/DELETE），前端通过 X-Admin-Token 头提交；
# 留空 = 写接口整体禁用（读接口不受影响）。长度须 ≥ 8。
ADMIN_TOKEN=
